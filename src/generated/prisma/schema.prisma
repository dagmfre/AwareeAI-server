// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  avatarUrl      String?
  dateJoined     DateTime @default(now())
  r2rDocumentIds String[] // Array of R2R document IDs (scalar lists in PG)
  docsLibrary    String[] // Library doc IDs (owned/shared)

  // Relations
  chats      Chat[]
  sharedDocs SharedDoc[]
}

model Chat {
  id             String   @id @default(uuid())
  title          String   @default("New Chat")
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  conversationId String?
  documentIds    String[] // R2R doc IDs
  messages       Json // Store as JSON (messages array with role, content, timestamp, citations, etc.)
  settings       Json // Store as JSON (SearchSettings, model, chunkCount, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SharedDoc {
  id              String   @id @default(uuid())
  title           String
  r2rDocumentId   String
  summary         String?
  originalOwnerId String
  originalOwner   User     @relation(fields: [originalOwnerId], references: [id])
  tags            String[]
  category        String?
  contentHash     String?  @unique
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
